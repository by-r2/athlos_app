# Copy to .env (shared) + .env.prod — gitignored.
# .env.local is committed (local Supabase defaults for `supabase start`).
# Makefile: `make run-ios` → .env.local | `make run-ios-device` → .env.prod

# =============================================================================
# .env — shared (devices, Gemini, optional overrides)
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key
SUPABASE_REDIRECT_URL=athlos://auth-callback

SIM_DEVICE="iPhone 17 Pro"
# SIM_UDID=
IOS_DEVICE_UDID=your_physical_iphone_udid
ANDROID_EMULATOR=dev_pixel7_api34

# Local Supabase: see committed `.env.local` (ANON_KEY JWT, not sb_publishable_*).
# Mailpit (auth emails): http://127.0.0.1:54324 | Studio: http://127.0.0.1:54323

# =============================================================================
# .env.prod — Supabase hosted (production / staging project)
# Copy this block to a file named `.env.prod`
# =============================================================================
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your_hosted_anon_key
